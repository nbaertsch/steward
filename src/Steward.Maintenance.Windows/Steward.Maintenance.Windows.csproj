<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UsesStewardSqlite>true</UsesStewardSqlite>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Steward.Maintenance.Windows</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Contracts.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="$(MicrosoftDataSqlitePackageVersion)" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <ProjectReference Include="..\Steward.Runtime.Windows\Steward.Runtime.Windows.csproj" />
    <ProjectReference Include="..\Steward.Contracts\Steward.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Steward.Maintenance.Windows.Tests" />
  </ItemGroup>
</Project>




