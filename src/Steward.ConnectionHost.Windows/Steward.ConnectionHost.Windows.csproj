<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UsesStewardSqlite>true</UsesStewardSqlite>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StewardNativeMSBuild Condition="Exists('$(ProgramFiles)\Microsoft Visual Studio\2022\Enterprise\MSBuild\Current\Bin\MSBuild.exe')">$(ProgramFiles)\Microsoft Visual Studio\2022\Enterprise\MSBuild\Current\Bin\MSBuild.exe</StewardNativeMSBuild>
    <StewardNativeMSBuild Condition="'$(StewardNativeMSBuild)' == '' and Exists('$(ProgramFiles)\Microsoft Visual Studio\2022\BuildTools\MSBuild\Current\Bin\MSBuild.exe')">$(ProgramFiles)\Microsoft Visual Studio\2022\BuildTools\MSBuild\Current\Bin\MSBuild.exe</StewardNativeMSBuild>
    <StewardNativeMSBuild Condition="'$(StewardNativeMSBuild)' == '' and Exists('$(MSBuildProgramFiles32)\Microsoft Visual Studio\2019\BuildTools\MSBuild\Current\Bin\MSBuild.exe')">$(MSBuildProgramFiles32)\Microsoft Visual Studio\2019\BuildTools\MSBuild\Current\Bin\MSBuild.exe</StewardNativeMSBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="$(MicrosoftDataSqlitePackageVersion)" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <ProjectReference Include="..\Steward.DevBox.Windows\Steward.DevBox.Windows.csproj" />
    <ProjectReference Include="..\Steward.Domain\Steward.Domain.csproj" />
    <ProjectReference Include="..\Steward.RdCore.Windows\Steward.RdCore.Windows.csproj" />
    <ProjectReference Include="..\Steward.Transport\Steward.Transport.csproj" />
    <ProjectReference Include="..\Steward.Transport.Rdp.Endpoint.Windows\Steward.Transport.Rdp.Endpoint.Windows.csproj" />
    <ProjectReference Include="..\Steward.Transport.Rdp.Windows\Steward.Transport.Rdp.Windows.csproj" />
    <ProjectReference Include="..\Steward.WindowsApp.RdCoreHook\Steward.WindowsApp.RdCoreHook.csproj" />
    <ProjectReference Include="..\Steward.RdpDvc.Client.Windows\Steward.RdpDvc.Client.Windows.csproj" />
  </ItemGroup>
  <Target Name="BuildStewardRdpDvcShim" BeforeTargets="PrepareForBuild">
    <Error
      Condition="'$(StewardNativeMSBuild)' == ''"
      Text="A supported Visual Studio MSBuild installation is required for Steward.RdpDvc.Shim.Windows." />
    <Exec
      Command="&quot;$(StewardNativeMSBuild)&quot; &quot;$(MSBuildProjectDirectory)\..\Steward.RdpDvc.Shim.Windows\Steward.RdpDvc.Shim.Windows.vcxproj&quot; /nologo /verbosity:minimal /property:Configuration=$(Configuration) /property:Platform=x64" />
    <Copy
      SourceFiles="..\Steward.RdpDvc.Shim.Windows\x64\$(Configuration)\Steward.RdpDvc.Shim.Windows.dll"
      DestinationFolder="$(OutputPath)" />
  </Target>
  <ItemGroup>
    <Content
      Include="..\Steward.RdpDvc.Shim.Windows\x64\$(Configuration)\Steward.RdpDvc.Shim.Windows.dll"
      Link="Steward.RdpDvc.Shim.Windows.dll"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest" />
    <Content
      Include="..\Steward.RdpDvc.Client.Windows\bin\$(Configuration)\net10.0-windows\Steward.RdpDvc.Client.Windows.dll"
      Link="Steward.RdpDvc.Client.Windows.dll"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest" />
    <Content
      Include="$(NuGetPackageRoot)system.security.cryptography.protecteddata\10.0.0\lib\net10.0\System.Security.Cryptography.ProtectedData.dll"
      Link="System.Security.Cryptography.ProtectedData.dll"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Steward.ConnectionHost.Windows.Tests" />
  </ItemGroup>
</Project>
